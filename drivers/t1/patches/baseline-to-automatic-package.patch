+		tb_dev->cur_tb_disp = APPLETB_CMD_DISP_UPD;
+		tb_dev->pnd_tb_mode = APPLETB_CMD_MODE_NONE;
+		tb_dev->pnd_tb_disp = APPLETB_CMD_DISP_NONE;
