+int appleib_tb_io_begin(void)
+{
+	if (!appleib_has_s3_quirk())
+		return 0;
+	mutex_lock(&appleib_tb_io_lock);
+	if (appleib_tb_blocked) {
+		mutex_unlock(&appleib_tb_io_lock);
+		return -EAGAIN;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(appleib_tb_io_begin);
+
+void appleib_tb_io_end(void)
+{
+	if (appleib_has_s3_quirk())
