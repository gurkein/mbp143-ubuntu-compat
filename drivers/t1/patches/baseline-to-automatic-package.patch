+/*
+ * PM notifiers run in process context. Serialize state and AML with prepare.
+ * POST occurs after device resume and task thaw, including failed transitions.
+ * These synchronous evaluations have NO hard timeout or cancellation guarantee.
+ */
+static int appleib_trace_pm_event(struct notifier_block *nb,
+				 unsigned long event, void *unused)
+{
+	struct appleib_device *ib_dev =
+		container_of(nb, struct appleib_device, trace_notifier);
+	acpi_status status;
+	int result = NOTIFY_DONE;
+
+	mutex_lock(&ib_dev->s3_lock);
+	switch (event) {
+	case PM_SUSPEND_PREPARE:
+        /* Advance only after successful firmware return and gated cache commit. */
+        if (appleib_has_s3_quirk()) {
+            mutex_lock(&appleib_tb_io_lock);
+            if (READ_ONCE(appleib_s3_status) == 3 ||
+                (ib_dev->s3_used && (!ib_dev->s3_cycle_ok ||
+                 ib_dev->s3_wake_pending || appleib_tb_blocked ||
+                 appleib_tb_refresh_pending ||
+                 READ_ONCE(appleib_s3_status) != 4))) {
+                result = NOTIFY_BAD;
+            } else if (ib_dev->s3_used) {
+                ib_dev->s3_used = false;
+                ib_dev->s3_wake_attempted = false;
+                ib_dev->s3_sleep_failed = false;
+                ib_dev->s3_cycle_ok = false;
+                WRITE_ONCE(appleib_s3_status, 0);
+                pr_info("appleib-pm phase=s3_next_cycle_ready\n");
+            }
+            mutex_unlock(&appleib_tb_io_lock);
+            if (result == NOTIFY_BAD)
+                break;
+        }
+        if (appleib_has_s3_quirk() &&
+            (ib_dev->s3_used || ib_dev->s3_wake_pending)) {
+            result = NOTIFY_BAD;
+            break;
+        }
+		ib_dev->trace_prepared = true;
+		ib_dev->trace_s3_seen = false;
+		if (pm_trace)
+			pr_info("appleib-pm phase=prepare target_snapshot=%d acpi_snapshot=%u\n",
+				pm_suspend_target_state, acpi_target_system_state());
+		result = NOTIFY_OK;
+		break;
+	case PM_POST_SUSPEND:
+		if (pm_trace)
+			pr_info("appleib-pm phase=post prepared=%d s3_target_seen=%d target_snapshot=%d acpi_snapshot=%u\n",
+				ib_dev->trace_prepared, ib_dev->trace_s3_seen,
+				pm_suspend_target_state, acpi_target_system_state());
+		/* Pair even an unsuccessful SOCW(0): AML may have changed hardware. */
+		if (ib_dev->s3_wake_pending && !ib_dev->s3_wake_attempted) {
+			ib_dev->s3_wake_attempted = true;
+			mutex_lock(&appleib_tb_io_lock);
+			pr_info("appleib-pm phase=s3_notify_wake_begin\n");
+			status = acpi_execute_simple_method(ib_dev->asoc_socw, NULL, 1);
+			pr_info("appleib-pm phase=s3_notify_wake_end status=%u\n", status);
+            if (ACPI_SUCCESS(status)) {
+                ib_dev->s3_cycle_ok = !ib_dev->s3_sleep_failed &&
+                                      pm_resume_via_firmware();
+                if (appleib_has_s3_quirk()) {
+                    appleib_tb_refresh_pending = true;
+                    /* A pre-existing worker error is terminal for this boot. */
+                    if (READ_ONCE(appleib_s3_status) != 3)
+                        WRITE_ONCE(appleib_s3_status,
+                                   ib_dev->s3_cycle_ok ? 2 : 3);
+                }
+                ib_dev->s3_wake_pending = false;
+				/* Invalidate and queue while workers are still excluded. */
+				blocking_notifier_call_chain(&appleib_tb_wake_chain, 0, NULL);
+				appleib_tb_blocked = false;
+            } else {
+                if (appleib_has_s3_quirk())
+                    WRITE_ONCE(appleib_s3_status, 3);
+                /* Terminal failure: leave USB mode work blocked, no polling. */
+				pr_err("appleib-pm S3 wake notification failed; no retry\n");
+			}
+			mutex_unlock(&appleib_tb_io_lock);
+		}
+		ib_dev->trace_prepared = false;
+		ib_dev->trace_s3_seen = false;
+		result = NOTIFY_OK;
+		break;
+	default:
+		break;
+	}
+	mutex_unlock(&ib_dev->s3_lock);
+	return result;
+}
+
+/* Device prepare has the target and precedes ACPI's EC blocking phase. */
+static int appleib_s3_prepare(struct appleib_device *ib_dev)
+{
+	acpi_status status;
+	int result = 0;
+
+	if (!appleib_has_s3_quirk())
+		return 0;
+	mutex_lock(&ib_dev->s3_lock);
+	if (ib_dev->s3_used || ib_dev->s3_wake_pending) {
+		result = -EBUSY;
+		goto out;
+	}
+	if (pm_suspend_target_state != PM_SUSPEND_MEM ||
+	    acpi_target_system_state() != ACPI_STATE_S3)
+		goto out;
+	if (!ib_dev->trace_prepared) {
+		result = -EPERM;
+		goto out;
+	}
+	/* Consume and latch BEFORE AML, also covering partial execution/failure. */
+	ib_dev->s3_used = true;
+	ib_dev->s3_sleep_failed = false;
+	ib_dev->s3_cycle_ok = false;
+	ib_dev->s3_wake_pending = true;
+	ib_dev->trace_s3_seen = true;
+	/* Drain an in-flight TB transaction/cache update before notifying firmware. */
+	mutex_lock(&appleib_tb_io_lock);
+	appleib_tb_blocked = true;
+	if (appleib_has_s3_quirk())
+		WRITE_ONCE(appleib_s3_status, 1);
+	pr_info("appleib-pm phase=s3_notify_sleep_begin\n");
+	status = acpi_execute_simple_method(ib_dev->asoc_socw, NULL, 0);
+	pr_info("appleib-pm phase=s3_notify_sleep_end status=%u\n", status);
+	mutex_unlock(&appleib_tb_io_lock);
+    if (ACPI_FAILURE(status)) {
+        ib_dev->s3_sleep_failed = true;
+        if (appleib_has_s3_quirk())
+            WRITE_ONCE(appleib_s3_status, 3);
+        result = -EIO;
+    }
+out:
+	mutex_unlock(&ib_dev->s3_lock);
+	return result;
+}
 
