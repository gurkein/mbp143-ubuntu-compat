 struct appleib_device {
 	acpi_handle asoc_socw;
+	struct notifier_block trace_notifier;
+	bool trace_prepared;
+	bool trace_s3_seen;
+	u32 original_pm_flags;
+	struct mutex s3_lock;
+	bool s3_used;
+	bool s3_wake_pending;
+	bool s3_wake_attempted;
+	bool s3_sleep_failed;
+	bool s3_cycle_ok;
 };
