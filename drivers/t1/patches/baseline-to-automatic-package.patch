+/* Caller holds the I/O gate; never take s3_lock from a Touch Bar worker. */
+bool appleib_tb_report_result(bool refreshed, int result)
+{
+    if (!appleib_has_s3_quirk())
+        return false;
+    lockdep_assert_held(&appleib_tb_io_lock);
+    if (result < 0) {
+        appleib_tb_blocked = true;
+        WRITE_ONCE(appleib_s3_status, 3);
+        pr_err("appleib-pm phase=s3_io_failed result=%d\n", result);
+        return true;
+    } else if (refreshed && appleib_tb_refresh_pending &&
+               READ_ONCE(appleib_s3_status) == 2) {
+        appleib_tb_refresh_pending = false;
+        WRITE_ONCE(appleib_s3_completed, appleib_s3_completed + 1);
+        WRITE_ONCE(appleib_s3_status, 4);
+        pr_info("appleib-pm phase=s3_cycle_complete count=%u\n",
+                appleib_s3_completed);
+    }
+    return false;
+}
+EXPORT_SYMBOL_GPL(appleib_tb_report_result);
